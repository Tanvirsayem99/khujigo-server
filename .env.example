# ---------------------------------------------------------------------------
# KhujiGo API — environment variables
# Copy to `.env` and adjust. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Runtime connection (used by the app).
# Supabase: use the transaction pooler (port 6543) with ?pgbouncer=true.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Migrations + seeding (used by `prisma migrate` / `prisma db seed`).
# A pooler in transaction mode cannot run DDL, so this must be a direct or
# session-mode connection (Supabase session pooler = port 5432, no ?pgbouncer).
# Local Postgres: the same URL as DATABASE_URL works fine.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Local Postgres equivalents (no pooler, one URL is enough) --------------
# DATABASE_URL="postgresql://postgres:<password>@localhost:5432/khujigo?schema=public"
# DIRECT_URL="postgresql://postgres:<password>@localhost:5432/khujigo?schema=public"
#
# --- docker-compose.yml alternative (host port 5433) ------------------------
# DATABASE_URL="postgresql://khujigo:khujigo@localhost:5433/khujigo?schema=public"

# JWT signing secrets — change these in every environment.
JWT_ACCESS_SECRET="change-me-dev-access-secret-please-rotate-in-production"
JWT_REFRESH_SECRET="change-me-dev-refresh-secret-please-rotate-in-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# HTTP
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- Seeded admin passwords -------------------------------------------------
# Read by `prisma/seed.ts` (via `npm run prisma:seed` / `db:setup`). Leave a
# value blank and the seed generates a random password, printing it once.
# Rotate an existing account with: ADMIN_EMAIL=... ADMIN_PASSWORD=... npm run admin:password
SUPER_ADMIN_PASSWORD=""
ADMIN_PASSWORD=""
STAFF_PASSWORD=""
